{
  "manifest_version": 3,
  "name": "Copy Cat",
  "version": "1.0",
  "description": "Easily copy any web content to your clipboard (text from link, buttons, lists, labels, paragraphs etc.)",
  "permissions": [
    "clipboardWrite",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "16.png",
    "32": "32.png",
    "48": "48.png",
    "128": "128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "16.png",
      "32": "32.png",
      "48": "48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-history-picker": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open the Copy Cat history picker for the focused field"
    },
    "toggle-history-panel": {
      "suggested_key": { "default": "Ctrl+Shift+H", "mac": "Command+Shift+H" },
      "description": "Show or hide the Copy Cat history panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "style-icons.js",
        "content/state.js",
        "content/text-zoom.js",
        "content/bookends.js",
        "content/overlay.js",
        "content/text-metrics.js",
        "content/names.js",
        "content/selection.js",
        "content/navigate.js",
        "content/output.js",
        "content/events.js",
        "content/lifecycle.js",
        "content/insert.js",
        "content/picker.js",
        "content/formsnap.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}