{
  "manifest_version": 3,
  "name": "Copy Cat",
  "version": "1.0",
  "description": "Easily copy any web content to your clipboard (text from link, buttons, lists, labels, paragraphs etc.)",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "16.png",
    "48": "48.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "16.png",
      "48": "48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}