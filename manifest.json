{
  "manifest_version": 3,
  "name": "Copy Cat",
  "version": "1.0",
  "description": "Easily copy any web content to your clipboard (text from link, buttons, lists, labels, paragraphs etc.)",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "16.png",
    "32": "32.png",
    "48": "48.png",
    "128": "128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "16.png",
      "32": "32.png",
      "48": "48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/state.js",
        "content/text-zoom.js",
        "content/bookends.js",
        "content/overlay.js",
        "content/text-metrics.js",
        "content/names.js",
        "content/selection.js",
        "content/output.js",
        "content/events.js",
        "content/lifecycle.js"
      ],
      "run_at": "document_start"
    }
  ]
}